# Template only. Real generated passwords go in ignored database/.env.dev.
# Compose uses only MYSQL_ROOT_PASSWORD; DB_* describe the future local backend.
MYSQL_ROOT_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=enterflow_db
DB_USER=enterflow_app
DB_PASSWORD=
DB_POOL_MAX=5
DB_TIMEZONE=Z
# Exact browser origin required by same-origin authentication/CSRF checks.
APP_ORIGIN=http://localhost:5173
# Optional future Cloud SQL route; leave empty for this local TCP configuration.
DB_SOCKET_PATH=
# Private document storage is disabled until an authorized development bucket and ADC are configured.
GCS_STORAGE_ENABLED=false
GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
