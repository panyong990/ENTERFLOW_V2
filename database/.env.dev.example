# Template only. Real generated passwords go in ignored database/.env.dev.
# Compose uses only MYSQL_ROOT_PASSWORD; DB_* describe the future local backend.
MYSQL_ROOT_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=enterflow_db
DB_USER=enterflow_app
DB_PASSWORD=
DB_POOL_MAX=5
DB_TIMEZONE=Z
# Optional future Cloud SQL route; leave empty for this local TCP configuration.
DB_SOCKET_PATH=
