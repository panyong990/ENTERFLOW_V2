# Copy to database/.env.migrations. This is separate from backend credentials.
DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=enterflow_db
DB_MIGRATION_USER=enterflow_migrator
DB_MIGRATION_PASSWORD=
# Local Docker only. Prefer DB_SSL_CA=<path> when you have a trusted certificate.
DB_SSL_LOCAL_SELF_SIGNED=true
DB_SSL_CA=
