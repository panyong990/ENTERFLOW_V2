+      }
+      else if (sql.includes("SET state='failed'")) {
+        if (failMarker) throw new Error('synthetic unavailable marker');
+        ledger.find(r => r.file === params[1]).state = 'failed';
+      } else if (sql.includes("SET state='applied'")) {
